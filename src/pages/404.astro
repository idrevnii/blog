---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="Not found">
  <section class="not-found">
    <h1>Nothing was logged here.</h1>
    <a class="arrow-link" href={withBase()}>return to index</a>
  </section>
</BaseLayout>

<style>
  .not-found { padding: clamp(48px, 8vw, 128px) var(--pad); }
  h1 { max-width: 800px; margin: 0 0 48px; font-size: clamp(50px, 7vw, 110px); font-weight: 430; letter-spacing: -.06em; line-height: .95; }
  @media (max-width: 760px) { .not-found { padding: 48px 16px; } }
</style>
