---
import Figure from './Figure.astro';
import type { Tick } from '../../data/midas-charts';

export interface LineSeries {
  name: string;
  tone?: 'ink' | 'muted';
  values: number[];
  /** Per-point <title> tooltips. */
  titles?: string[];
}

interface Props {
  title?: string;
  note?: string;
  showSource?: boolean;
  series: LineSeries[];
  xLabels: string[];
  yTicks: Tick[];
  yDomain: [number, number];
  xLabel?: string;
  yLabel?: string;
}

const { title, note, series, xLabels, yTicks, yDomain, xLabel, yLabel, showSource = true } = Astro.props;

const W = 720;
const H = 310;
const T = 32;
const B = 56;
const L = 64;
const endLabelW = Math.max(...series.map((s) => s.name.length)) * 8.8 + 22;
const R = endLabelW;
const plotW = W - L - R;
const plotH = H - T - B;

const n = xLabels.length;
const X = (i: number) => L + (n > 1 ? (i / (n - 1)) * plotW : plotW / 2);
const Y = (v: number) => T + (1 - (v - yDomain[0]) / (yDomain[1] - yDomain[0])) * plotH;

const lines = series.map((s) => {
  const pts = s.values.map((v, i) => ({
    x: X(i), y: Y(v),
    labelY: Y(v) + (v === Math.max(...series.map(other => other.values[i])) ? -14 : 22),
  }));
  return {
    ...s,
    pts,
    path: pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' '),
  };
});
---

<Figure {title} {note} {showSource} headers={[Astro.url.pathname.includes('/ru/') ? 'Соперник' : 'Opponent', ...series.map(s => s.name)]} rows={xLabels.map((label, i) => [label, ...series.map(s => `${s.values[i].toFixed(1)}%`)])}>
  <svg data-chart="lines" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {yTicks.map((t) => (
      <g>
        <line x1={L} y1={Y(t.value)} x2={L + plotW} y2={Y(t.value)} class="grid" />
        <text x={L - 24} y={Y(t.value) + 5} class="ax numeric" text-anchor="end">{t.label}</text>
      </g>
    ))}
    {xLabels.map((label, i) => (
      <g>
        <line x1={X(i)} y1={T} x2={X(i)} y2={T + plotH} class="guide" />
        <text x={X(i)} y={H - B + 24} class="ax" text-anchor="middle">{label}</text>
      </g>
    ))}
    {lines.map((line) => (
      <g>
        <path d={line.path} class={`line ${line.tone ?? 'ink'}`} />
        {line.pts.map((p, i) => (
          <g>
            <circle cx={p.x} cy={p.y} r="4.5" class={`dot ${line.tone ?? 'ink'}`}>
              <title>{line.titles?.[i] ?? `${xLabels[i]} · ${line.name}: ${line.values[i].toFixed(1)}%`}</title>
            </circle>
            <text x={p.x} y={p.labelY} class="value numeric" text-anchor="middle">{Math.round(line.values[i])}%</text>
          </g>
        ))}
        <text x={line.pts[n - 1].x + 14} y={line.pts[n - 1].y + 5} class={`end ${line.tone ?? 'ink'}`}>{line.name}</text>
      </g>
    ))}
    {yLabel && <text x="2" y="16" class="ax">{yLabel}</text>}
    {xLabel && <text x={L + plotW} y={H - 6} class="ax" text-anchor="end">{xLabel}</text>}
  </svg>
</Figure>

<style>
  .ax { fill: var(--muted); }
  .grid { stroke: var(--line); }
  .guide { stroke: var(--line); stroke-dasharray: 2 5; }
  .value { fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 4px; stroke-linejoin: round; }
  .line.ink { fill: none; stroke: var(--fill); stroke-width: 2; stroke-linejoin: round; }
  .line.muted { fill: none; stroke: var(--muted); stroke-width: 2; stroke-linejoin: round; stroke-dasharray: 5 4; }
  .dot.ink { fill: var(--fill); }
  .dot.muted { fill: var(--paper); stroke: var(--muted); stroke-width: 2; }
  .end.ink { fill: var(--ink); }
  .end.muted { fill: var(--muted); }
</style>
