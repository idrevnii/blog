---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="fold article-details">
  <summary>{summary}</summary>
  <div class="fold-b">
    <slot />
  </div>
</details>

<style>
  .fold { margin: 24px 0 8px; }
  .fold-b { padding: 2px 0 16px; }
  .fold-b > :global(*:first-child) { margin-top: 0; }
</style>
