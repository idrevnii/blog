---
import Figure from './Figure.astro';
import type { ScatterPoint, Tick } from '../../data/midas-charts';

interface Props {
  title?: string;
  note?: string;
  points: ScatterPoint[];
  xTicks: Tick[];
  yTicks: Tick[];
  xDomain: [number, number];
  yDomain: [number, number];
  xLabel?: string;
  yLabel?: string;
  /** Least-squares trend segment in data units. */
  trend?: { x1: number; y1: number; x2: number; y2: number };
}

const { title, note, points, xTicks, yTicks, xDomain, yDomain, xLabel, yLabel, trend } = Astro.props;

const W = 680;
const H = 350;
const L = 58;
const R = 20;
const T = 26;
const B = 48;
const plotW = W - L - R;
const plotH = H - T - B;

const X = (v: number) => L + ((v - xDomain[0]) / (xDomain[1] - xDomain[0])) * plotW;
const Y = (v: number) => T + (1 - (v - yDomain[0]) / (yDomain[1] - yDomain[0])) * plotH;

const pts = points.map((p) => ({ ...p, cx: X(p.x), cy: Y(p.y) }));
const trendLine = trend
  ? { x1: X(trend.x1), y1: Y(trend.y1), x2: X(trend.x2), y2: Y(trend.y2) }
  : null;
---

<Figure {title} {note}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {yTicks.map((t) => (
      <g>
        <line x1={L} y1={Y(t.value)} x2={L + plotW} y2={Y(t.value)} class="grid" />
        <text x={L - 10} y={Y(t.value) + 3.5} class="ax" text-anchor="end">{t.label}</text>
      </g>
    ))}
    {xTicks.map((t) => (
      <text x={X(t.value)} y={H - B + 20} class="ax" text-anchor="middle">{t.label}</text>
    ))}
    {trendLine && <line x1={trendLine.x1} y1={trendLine.y1} x2={trendLine.x2} y2={trendLine.y2} class="trend" />}
    {pts.map((p) => (
      <g>
        <circle cx={p.cx} cy={p.cy} r="5.5" class="dot">
          {p.title && <title>{p.title}</title>}
        </circle>
        {p.label && (
          <text
            x={p.cx + (p.dx ?? 9)}
            y={p.cy + (p.dy ?? 4)}
            class="lbl"
            text-anchor={p.anchor ?? 'start'}
          >
            {p.label}
          </text>
        )}
      </g>
    ))}
    {yLabel && <text x="2" y="13" class="ax">{yLabel}</text>}
    {xLabel && <text x={L + plotW} y={H - 6} class="ax" text-anchor="end">{xLabel}</text>}
  </svg>
</Figure>

<style>
  text { font-family: var(--mono); }
  .ax { fill: var(--muted); font-size: 10.5px; }
  .lbl { fill: var(--muted); font-size: 10.5px; }
  .grid { stroke: var(--line); }
  .trend { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .dot { fill: var(--fill); }
</style>
