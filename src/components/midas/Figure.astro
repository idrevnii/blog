---
import { withBase } from '../../lib/site';
interface Props {
  title?: string;
  note?: string;
  source?: string;
  showSource?: boolean;
  headers?: string[];
  rows?: (string | number)[][];
  modelLabels?: boolean;
  spacious?: boolean;
}

const { title, note, source = '/research/midas/verified.json', headers, rows, showSource = true, modelLabels = false, spacious = false } = Astro.props;
const isRu = Astro.url.pathname.includes('/ru/');
---

<figure class:list={['fig', { 'fig-spacious': spacious }]}>
  {title && <figcaption class="fig-t">{title}</figcaption>}
  <div class="fig-body" tabindex="0" role="region" aria-label={title}>
    <slot />
  </div>
  {note && <p class="fig-n supporting-text">{note}</p>}
  {headers && rows && <details class="fig-data article-details">
    <summary>{isRu ? 'Числа в таблице' : 'View numbers'}</summary>
    <div class="fig-table" tabindex="0" role="region" aria-label={title}><table>
      <caption>{title}</caption>
      <thead><tr>{headers.map(h => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row" class:list={{ 'model-name': modelLabels }}>{cell}</th> : <td class="numeric">{cell}</td>)}</tr>)}</tbody>
    </table></div>
  </details>}
  {showSource && <a class="fig-source supporting-text" href={withBase(source)}>
    {isRu ? 'Данные графика' : 'Chart data'}
  </a>}
</figure>

<style>
  .fig { margin: 48px 0; }
  .fig-t {
    margin: 0 0 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 20px;
    font-weight: 650;
    line-height: 28px;
    text-wrap: balance;
    text-transform: none;
    letter-spacing: normal;
  }
  .fig-body { overflow-x: auto; }
  /* At the 640px minimum width, the 720-unit charts still render text above 14px. */
  .fig-body :global(svg) { display: block; width: 100%; height: auto; min-width: 640px; font: 400 16px/1 var(--sans); font-variant-numeric: tabular-nums; }
  .fig-n { margin: 16px 0 0; }
  .fig-spacious .fig-t { margin-bottom: 24px; }
  .fig-spacious .fig-n { margin-top: 24px; }
  .fig-source { display: inline-block; margin-top: 8px; }
  .fig-data { margin-top: 12px; }
  .fig-table { overflow-x: auto; }
  .fig-data table { margin-top: 12px; }
  .fig-data th, .fig-data td { padding: 12px 8px; }
  .fig-data th:first-child, .fig-data td:first-child { padding-left: 0; }
  @media (max-width: 760px) {
    .fig { margin: 32px 0 48px; }
  }
</style>
