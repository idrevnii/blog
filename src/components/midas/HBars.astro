---
import Figure from './Figure.astro';
import type { HBarRow } from '../../data/midas-charts';

interface Props {
  title?: string;
  note?: string;
  rows: HBarRow[];
  showTable?: boolean;
  showSource?: boolean;
  modelLabels?: boolean;
  spacious?: boolean;
  /** Explicit value domain; defaults to [min(0, values…), max(0, values…)]. */
  domain?: [number, number];
  /** Dashed vertical reference line, in data units. */
  rule?: { at: number; label?: string };
}

const { title, note, rows, domain, rule, spacious = false, showTable = true, showSource = true, modelLabels = false } = Astro.props;
const isRu = Astro.url.pathname.includes('/ru/');

const W = 720;
const ROW = spacious ? 42 : 34;
const BAR = 24;
const TOP = 2;
const SUB_GAP = spacious ? 16 : 8;
const charW = 9.7;
const labelCharW = 8.8;

const maxLabelLen = Math.max(...rows.map((r) => r.label.length));
const labelW = Math.min(250, Math.max(80, maxLabelLen * (modelLabels ? charW : labelCharW) + 6));
const labelParts = (label: string) => label.split(/(\d+(?:[.,]\d+)?%?)/).map(text => ({ text, numeric: /^\d/.test(text) }));

const textW = (r: HBarRow) => r.display.length * charW + (r.sub ? r.sub.length * charW + SUB_GAP : 0);
const pos = rows.filter((r) => r.value >= 0);
const neg = rows.filter((r) => r.value < 0);
const posTextW = pos.length ? Math.max(...pos.map(textW)) + 10 : 12;
const negTextW = neg.length ? Math.max(...neg.map(textW)) + 10 : 0;

const x0 = labelW + 14 + negTextW;
const plotW = W - x0 - 10 - posTextW;

const values = rows.map((r) => r.value);
const lo = Math.min(0, ...values, rule ? rule.at : 0, ...(domain ?? []));
const hi = Math.max(0, ...values, rule ? rule.at : 0, ...(domain ?? []));
const scale = plotW / (hi - lo || 1);
const originX = x0 + (0 - lo) * scale;
const H = rows.length * ROW + 10 + (rule?.label ? 22 : 0);

const bars = rows.map((row, i) => {
  const y = TOP + i * ROW;
  const len = Math.abs(row.value) * scale;
  const barX = row.value >= 0 ? originX : originX - len;
  return {
    ...row,
    y,
    cy: y + BAR / 2,
    barX,
    len,
    right: row.value >= 0,
    tx: row.value >= 0 ? barX + len + 8 : barX - 8,
  };
});
const ruleX = rule ? x0 + (rule.at - lo) * scale : null;
---

<Figure {title} {note} {showSource} {modelLabels} {spacious} headers={isRu ? ['Вариант', 'Значение'] : ['Entry', 'Value']} rows={showTable ? rows.map(r => [r.label, r.display]) : undefined}>
  <svg data-chart="bars" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {bars.map((b) => (
      <rect x={b.barX} y={b.y} width={b.len} height={BAR} class={`bar ${b.variant ?? 'solid'}`}>
        <title>{`${b.label}: ${b.display}`}</title>
      </rect>
    ))}
    {/* Keep the reference visible at the bar origin, but behind the value labels. */}
    {ruleX !== null && <line x1={ruleX} y1="0" x2={ruleX} y2={rows.length * ROW + 4} class="rule" />}
    {bars.map((b) => (
      <g>
        <text x={labelW} y={b.cy + 5} class:list={['lbl', { 'model-name': modelLabels }]} text-anchor="end">{modelLabels ? b.label : labelParts(b.label).map(part => <tspan class:list={{ numeric: part.numeric }}>{part.text}</tspan>)}</text>
        <text x={b.tx} y={b.cy + 5} class="val numeric" text-anchor={b.right ? 'start' : 'end'}>
          {b.display}{b.sub && <tspan class="sub" dx={SUB_GAP}>{b.sub}</tspan>}
        </text>
      </g>
    ))}
    {rule?.label && ruleX !== null && <text x={ruleX} y={H - 6} class="ax" text-anchor="middle">{labelParts(rule.label).map(part => <tspan class:list={{ numeric: part.numeric }}>{part.text}</tspan>)}</text>}
  </svg>
</Figure>

<style>
  .lbl { fill: var(--muted); }
  .val { fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 4px; stroke-linejoin: round; }
  .sub { fill: var(--muted); }
  .ax { fill: var(--muted); }
  .rule { stroke: var(--fill-soft); stroke-dasharray: 4 4; }
  .bar.solid { fill: var(--fill); }
  .bar.outline { fill: var(--paper); stroke: var(--fill); stroke-width: 1.4; }
  .bar.faint { fill: var(--fill-soft); }
</style>
